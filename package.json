{
  "name": "no-extraction",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --port 5190",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 5191 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "node tools/lint.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "bot": "node tools/bot.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && vite build && node tools/bot.mjs"
  },
  "dependencies": {
    "@slu/web-shell": "github:mikeylambo/Web-Game-Shell-v1.02#7003ec7a46f0de4c86b8dbb28fea81c10d4f21fa",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.180.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^7.3.7"
  }
}
