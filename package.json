{
  "name": "no-extraction",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --port 5190",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 5191 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "node tools/lint.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "bot": "node tools/bot.mjs",
    "check": "npm run typecheck && npm run lint && npm run script:check && npm run test && vite build && node tools/bot.mjs ch1,ch2,ch3,ch4,ch5,ch6",
    "shots": "node tools/shots.mjs",
    "lookdev-shots": "node tools/lookdev-shots.mjs",
    "audio-delivery": "tsx tools/audio-delivery.ts",
    "kit-templates": "tsx tools/kit-templates.ts",
    "script:check": "tsx tools/script.ts check",
    "script:import": "tsx tools/script.ts import && tsx tools/audio-delivery.ts",
    "script:export": "tsx tools/script.ts export",
    "check:fast": "npm run typecheck && npm run lint && npm run script:check && npm run test"
  },
  "dependencies": {
    "@slu/web-shell": "github:mikeylambo/Web-Game-Shell-v1.02#7003ec7a46f0de4c86b8dbb28fea81c10d4f21fa",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.180.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^7.3.7"
  }
}
